        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({p_chat_id:$json.chat_id,p_action:$json.action,p_args:$json.args}) }}",
