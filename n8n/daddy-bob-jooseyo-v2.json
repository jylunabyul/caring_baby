        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": "={{ ($json.buttons || []).length ? [{row:{buttons:$json.buttons.map(b => ({text:b.text, additionalFields:{callback_data:b.data} }))} }] : [] }}"
        },
