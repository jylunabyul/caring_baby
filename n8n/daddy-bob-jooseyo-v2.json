      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1310,
        0
      ],
      "parameters": {
        "jsCode": "if ($json.reply && $json.chat_id) return [{json:$json}];\nreturn [{json:{chat_id:'9114513581',reply:'처리하지 못했어요. 기록은 저장되지 않았을 수 있습니다. /history 아이이름으로 먼저 확인하고, 재고 입력·명령 형식 및 n8n 실행 오류를 확인해 주세요.',buttons:[]}}];"
      }
