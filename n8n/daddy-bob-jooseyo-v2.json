            "version": 2
          },
          "conditions": [
            {
              "id": "cb",
              "leftValue": "={{ $json.callback_id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
